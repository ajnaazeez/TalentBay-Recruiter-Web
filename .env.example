# ==============================================================================
# TalentBay Recruiter Web - Client Environment Configuration
# ==============================================================================
# NOTE: Only prefix variables with VITE_ to expose them to the browser client.
# NEVER put private secrets (Razorpay Secret, Gemini API key, Firebase Admin,
# Service Account Private Keys) into frontend environment files.
# ==============================================================================

# Firebase Web SDK Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=talent-bay-d0b92.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=talent-bay-d0b92
VITE_FIREBASE_STORAGE_BUCKET=talent-bay-d0b92.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase Cloud Messaging Web Push Certificate (VAPID public key)
VITE_FIREBASE_VAPID_KEY=your_public_vapid_key_here

# App Info
VITE_APP_NAME="TalentBay Recruiter"
VITE_APP_ENV=development
